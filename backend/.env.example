# =======================================================
# GeoMiner Backend — Production Configuration Template
# =======================================================

# 1. Google Earth Engine Authentication
# For local dev: place credentials.json in backend/ and set email:
GEE_PROJECT=ee-nelizah99
GEE_SERVICE_ACCOUNT=geoclass@ee-nelizah99.iam.gserviceaccount.com
GEE_KEY_FILE=credentials.json

# For Cloud Platforms (Railway, Render, AWS, GCP, Fly.io):
# You can supply the entire service account JSON as a base64 string:
# (Run: `cat credentials.json | base64` on macOS/Linux)
# GEE_SERVICE_ACCOUNT_JSON_B64=eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIs...

# Or as raw JSON string:
# GEE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# 2. CORS & Allowed Frontend Origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 3. Server Port
PORT=8000
